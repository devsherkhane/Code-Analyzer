{
  "name": "uiux-copilot",
  "displayName": "UI/UX Copilot",
  "description": "Real-time AI-powered UI/UX and accessibility checker.",
  "version": "0.0.1",
  "publisher": "devs",
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Linters"
  ],
  "activationEvents": [
    "*"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "uiux-copilot.applyFix",
        "title": "Apply UI/UX AI Fix"
      },
      {
        "command": "uiux-copilot.showDashboard",
        "title": "UI/UX Dashboard",
        "icon": "$(dashboard)"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "build": "npm run compile"
  },
  "devDependencies": {
    "@types/vscode": "^1.70.0",
    "@types/node": "^18.x",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "axios": "^1.4.0"
  }
}
